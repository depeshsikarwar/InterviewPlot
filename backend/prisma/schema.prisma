// Prisma Schema for InterviewPilot AI
// PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum InterviewType {
  HR
  TECHNICAL
  CODING
}

enum InterviewMode {
  TEXT
  VOICE
}

enum InterviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILE_ERROR
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TestCaseType {
  SAMPLE
  HIDDEN
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String
  role             Role             @default(USER)
  isVerified       Boolean          @default(false)
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  profile          Profile?
  skills           UserSkill[]
  resumes          Resume[]
  jobDescriptions  JobDescription[]
  interviews       Interview[]
  answers          Answer[]
  codeSubmissions  CodeSubmission[]
  learningPlans    LearningPlan[]
  usageRecords     UsageRecord[]
  consents         UserConsent?
  refreshSessions  RefreshSession[]
  skillAssessments SkillAssessment[]

  @@index([email])
}

model Profile {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                  String
  education                 String?
  degree                    String?
  graduationYear            Int?
  targetRole                String    @default("Software Engineer")
  experienceLevel           String    @default("Fresher") // Fresher, Junior, Mid, Senior
  programmingLanguages      String[]  @default(["Python", "JavaScript"])
  technicalSkills           String[]  @default([])
  projects                  Json?     // Array of project objects
  internshipExperience      Json?     // Array of internship objects
  preferredInterviewLanguage String   @default("English")
  dailyStudyMinutes         Int       @default(60)
  preferredInterviewDuration Int      @default(30)
  careerGoals               String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model Skill {
  id               String            @id @default(uuid())
  name             String            @unique
  category         String            // DSA, CS Fundamentals, Frontend, Backend, HR/Behavioral, System Design
  description      String?
  createdAt        DateTime          @default(now())

  userSkills       UserSkill[]
  learningTasks    LearningTask[]
  skillAssessments SkillAssessment[]

  @@index([category])
}

model UserSkill {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiencyScore Float     @default(0.0) // 0 to 100
  confidenceLevel  Float     @default(0.5) // 0 to 1
  totalAttempts    Int       @default(0)
  lastAssessedAt   DateTime?
  updatedAt        DateTime  @updatedAt

  @@unique([userId, skillId])
  @@index([userId])
}

model Resume {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName             String
  fileUrl              String
  fileSize             Int
  mimeType             String
  parsedText           String      @db.Text
  extractedSkills      String[]
  experienceHighlights String[]
  missingDetails       String[]
  recommendations      Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  interviews           Interview[]

  @@index([userId])
}

model JobDescription {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  company          String?
  rawText          String      @db.Text
  requiredSkills   String[]
  preferredSkills  String[]
  responsibilities String[]
  matchScore       Float?      // 0 to 100
  missingSkills    String[]
  suggestedTopics  String[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  interviews       Interview[]

  @@index([userId])
}

model QuestionBankItem {
  id             String              @id @default(uuid())
  title          String
  category       InterviewType       // HR, TECHNICAL, CODING
  topic          String              // e.g., "DSA: Arrays", "DBMS: Transactions", "HR: Conflict Resolution"
  difficulty     String              // Easy, Medium, Hard
  promptText     String              @db.Text
  starterCode    Json?               // Map of language => starter code
  sampleAnswer   String?             @db.Text
  rubric         Json?               // Rubric criteria and score guide
  testCases      Json?               // Array of sample & hidden test cases
  hints          String[]            @default([])
  isVerified     Boolean             @default(true)
  createdAt      DateTime            @default(now())

  interviewQuestions InterviewQuestion[]

  @@index([category, topic, difficulty])
}

model Interview {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  interviewType      InterviewType
  mode               InterviewMode       @default(TEXT)
  difficulty         String              @default("Medium") // Easy, Medium, Hard
  targetRole         String
  durationMinutes    Int                 @default(30)
  status             InterviewStatus     @default(PENDING)
  overallScore       Float?              // 0 to 100
  rubricScores       Json?               // Category/Dimension breakdown
  summaryFeedback    String?             @db.Text
  resumeId           String?
  resume             Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescriptionId   String?
  jobDescription     JobDescription?     @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  questions          InterviewQuestion[]
  evaluation         Evaluation?
  skillAssessments   SkillAssessment[]

  @@index([userId, status])
  @@index([interviewType])
}

model InterviewQuestion {
  id                 String            @id @default(uuid())
  interviewId        String
  interview          Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  orderIndex         Int
  questionBankItemId String?
  questionBankItem   QuestionBankItem? @relation(fields: [questionBankItemId], references: [id], onDelete: SetNull)
  questionText       String            @db.Text
  category           String            // e.g. "STAR: Leadership", "DSA: Binary Search"
  difficulty         String            @default("Medium")
  isFollowUp         Boolean           @default(false)
  parentQuestionId   String?
  parentQuestion     InterviewQuestion? @relation("QuestionFollowUps", fields: [parentQuestionId], references: [id], onDelete: SetNull)
  followUps          InterviewQuestion[] @relation("QuestionFollowUps")
  createdAt          DateTime          @default(now())

  answer             Answer?
  codeSubmissions    CodeSubmission[]

  @@index([interviewId, orderIndex])
}

model Answer {
  id                    String            @id @default(uuid())
  interviewQuestionId   String            @unique
  interviewQuestion     InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerText            String            @db.Text
  speechDurationSeconds Int?
  starComponents        Json?             // { situation, task, action, result }
  score                 Float?            // 1 to 5
  evidenceQuotes        String[]          @default([])
  feedback              String?           @db.Text
  improvementSuggestion String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId])
}

model CodeSubmission {
  id                   String            @id @default(uuid())
  interviewQuestionId  String
  interviewQuestion    InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  language             String            // python, javascript, cpp, java
  sourceCode           String            @db.Text
  status               SubmissionStatus  @default(PENDING)
  executionTimeMs      Int?
  memoryKb             Int?
  sampleTestsPassed    Int               @default(0)
  hiddenTestsPassed    Int               @default(0)
  totalTests           Int               @default(0)
  complexityExplanation String?          @db.Text
  estimatedTimeComplexity String?
  estimatedSpaceComplexity String?
  feedback             String?           @db.Text
  createdAt            DateTime          @default(now())

  testResults          TestResult[]

  @@index([userId])
  @@index([interviewQuestionId])
}

model TestResult {
  id               String         @id @default(uuid())
  codeSubmissionId String
  codeSubmission   CodeSubmission @relation(fields: [codeSubmissionId], references: [id], onDelete: Cascade)
  testCaseType     TestCaseType   @default(SAMPLE)
  input            String         @db.Text
  expectedOutput   String         @db.Text
  actualOutput     String?        @db.Text
  passed           Boolean        @default(false)
  executionTimeMs  Int?
  errorMessage     String?        @db.Text

  @@index([codeSubmissionId])
}

model Evaluation {
  id                   String    @id @default(uuid())
  interviewId          String    @unique
  interview            Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  overallScore         Float     // 0 to 100
  relevanceScore       Float?    // 1 to 5
  structureScore       Float?    // 1 to 5
  specificityScore     Float?    // 1 to 5
  ownershipScore       Float?    // 1 to 5
  resultsScore         Float?    // 1 to 5
  strengths            String[]
  weaknesses           String[]
  evidenceQuotes       String[]
  modelAnswerExample   String?   @db.Text
  revisionTopics       String[]
  recommendedTasks     Json?     // Suggested follow-up learning tasks
  confidenceScore      Float     @default(1.0)
  modelIdentifier      String    @default("gemini-1.5-flash")
  rubricVersion        String    @default("v1.0")
  createdAt            DateTime  @default(now())
}

model SkillAssessment {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  interviewId      String
  interview        Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  score            Float     // 0 to 100
  evaluationNotes  String?   @db.Text
  assessedAt       DateTime  @default(now())

  @@index([userId, skillId])
  @@index([interviewId])
}

model LearningPlan {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole       String
  weekStartDate    DateTime
  weekEndDate      DateTime
  summary          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tasks            LearningTask[]

  @@index([userId])
}

model LearningTask {
  id               String       @id @default(uuid())
  learningPlanId   String
  learningPlan     LearningPlan @relation(fields: [learningPlanId], references: [id], onDelete: Cascade)
  title            String
  skillId          String?
  skill            Skill?       @relation(fields: [skillId], references: [id], onDelete: SetNull)
  explanation      String       @db.Text
  estimatedMinutes Int          @default(45)
  priority         TaskPriority @default(MEDIUM)
  dueDate          DateTime?
  successCriteria  String       @db.Text
  status           TaskStatus   @default(PENDING)
  resourceUrl      String?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([learningPlanId])
}

model UsageRecord {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType      String   // INTERVIEW_QUESTION, EVALUATION, CODE_EXECUTION, RESUME_PARSE
  tokensUsed      Int      @default(0)
  executionTimeMs Int      @default(0)
  timestamp       DateTime @default(now())

  @@index([userId, timestamp])
}

model UserConsent {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioConsent    Boolean  @default(false)
  termsAccepted   Boolean  @default(true)
  privacyAccepted Boolean  @default(true)
  consentedAt     DateTime @default(now())
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}
