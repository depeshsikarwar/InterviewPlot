# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/interviewpilot_db?schema=public"

# Authentication & Security
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=your_cookie_signing_secret

# AI Engine Configuration
AI_PROVIDER=gemini # options: gemini, openai, mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Code Execution Service
CODE_EXECUTION_ENGINE=local # options: judge0, local
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
